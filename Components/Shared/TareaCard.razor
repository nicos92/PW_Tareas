@using TareasBlazor.Helpers
@using TareasBlazor.Models

<article class="card shadow-sm border-0">
    <div
        class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 @(Tarea.Completada ? "bg-success-subtle border-success-subtle" : "bg-secondary-subtle border-secondary-subtle")">
        <h4 class="card-title mb-0 text-body-emphasis">@Tarea.Titulo</h4>
        <span class="badge @(Tarea.Completada ? "bg-success" : "bg-secondary") rounded-pill fs-6">
            @(Tarea.Completada ? "Completada" : "Pendiente")
        </span>
    </div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            <i class="bi bi-hash" aria-hidden="true"></i> ID: <code>@Tarea.IdPublic</code>
        </p>
        <p class="text-muted small mb-3">
            <i class="bi bi-stack" aria-hidden="true"></i> categoria: <code>@Tarea.Categoria</code>
        </p>
        @if (!string.IsNullOrWhiteSpace(Tarea.Descripcion))
        {
            <p class="card-text lh-lg mb-0">@Tarea.Descripcion</p>
        }
        @if (!string.IsNullOrEmpty(Tarea.Imagen))
        {
            <div class="text-center mt-3">
                <img src="@Tarea.Imagen" alt="Imagen asociada a la tarea '@Tarea.Titulo'"
                     class="img-fluid rounded shadow-sm" style="max-height: 300px; width: auto; object-fit: contain;"
                     loading="lazy" />
            </div>
        }
    </div>
    <div
        class="card-footer bg-transparent border-top d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
        <span class="badge @PrioridadHelper.GetClase(Tarea.Prioridad) rounded-pill fs-6">
            Prioridad: @Tarea.Prioridad
        </span>
        <span class="text-muted small">
            <i class="bi bi-calendar3"></i> Vence: @Tarea.FechaVencimiento?.ToString("dd MMM yyyy")
        </span>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public TareaModel Tarea { get; set; } = default!;
}
