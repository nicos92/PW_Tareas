@using TareasBlazor.Helpers
@using TareasBlazor.Models

<article class="card shadow-sm border-0 col-sm-12">
    <div class="card-header d-flex justify-content-between align-items-center @(Tarea.Completada ? "bg-success-subtle border-success-subtle" : "bg-secondary-subtle border-secondary-subtle")">
        <h4 class="card-title mb-0 text-body-emphasis">@Tarea.Titulo</h4>
        <span class="badge @(Tarea.Completada ? "bg-success" : "bg-secondary") rounded-pill">
            @(Tarea.Completada ? "Completada" : "Pendiente")
        </span>
    </div>
    <div class="card-body">
        <p class="text-muted small mb-2"><i class="bi bi-hash" aria-hidden="true"></i> ID: <code>@Tarea.IdPublic</code></p>
        @if (!string.IsNullOrWhiteSpace(Tarea.Descripcion))
        {
            <p class="card-text lh-base mb-0">@Tarea.Descripcion</p>
        }
        @if (!string.IsNullOrEmpty(Tarea.Imagen))
        {
            <div class="text-center mt-2">
                <img src="@Tarea.Imagen" alt="Imagen asociada a la tarea '@Tarea.Titulo'" class="img-fluid rounded shadow-sm" style="max-width: 100%; max-height: 250px; object-fit: cover;"/>
            </div>
        }
    </div>
    <div class="card-footer bg-transparent border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="badge @PrioridadHelper.GetClase(Tarea.Prioridad) rounded-pill">
            Prioridad: @Tarea.Prioridad
        </span>
        <span class="text-muted small">
            Vence: @Tarea.FechaVencimiento?.ToString("dd MMM yyyy")
        </span>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public TareaModel Tarea { get; set; } = default!;
}
