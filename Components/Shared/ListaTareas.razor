@page "/listaDeTareas"
@rendermode InteractiveServer
@using TareasBlazor.Models

@implements IDisposable


<PageTitle>Lista de Tareas</PageTitle>
<Breadcrum></Breadcrum>
<h1>Lista de Tareas</h1>
<section class="card shadow-sm col-12 mb-3" aria-label="Lista de tareas">
    <div class="card-header">
        <h5 class="mb-0">Lista de tareas</h5>
    </div>
    <div class="card-body">

        <button class="btn btn-primary btn-lg my-2" @onclick="NuevaTarea" aria-label="Crear nueva tarea"><i
            class="bi bi-plus-circle" aria-hidden="true"></i> Nueva Tarea</button>

            <FilterBar PrioridadSeleccionada="_prioridadSeleccionada" EstadoSeleccionado="_completadaSeleccionada"
                       VencimientoSeleccionado="_vencimientoSeleccionado" TotalTareas="TareasFiltradas.Count()"
                       OnPrioridadChanged="OnPrioridadChanged" OnEstadoChanged="OnEstadoChanged"
                       OnVencimientoChanged="OnVencimientoChanged" />

            @if (!TareasFiltradas.Any())
            {
                <p class="text-muted mb-0" aria-live="polite">No hay tareas. Añade una arriba.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col" class="text-nowrap" style="width:1%">Completada</th>
                                <th scope="col">Título</th>
                                <th scope="col">Prioridad</th>
                                <th scope="col" class="text-nowrap" style="width:1%">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tarea in TareasFiltradas)
                            {
                                <TareaItem @key="tarea.IdPublic" Tarea="tarea" OnVer="VerTarea" OnCompletar="CompletarTarea"
                                           OnEliminar="EliminarTarea" OnEditar="IniciarEdicion" />
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

<ConfirmDialog IsVisible="_showDeleteModal" Message="¿Estás seguro de que deseas eliminar la tarea"
               TargetName="@_tareaAEliminar?.Titulo" OnConfirm="ConfirmarEliminar" OnCancel="CancelarEliminar" />

@code {
    private string _prioridadSeleccionada = string.Empty;
    private string _completadaSeleccionada = string.Empty;
    private string _vencimientoSeleccionado = string.Empty;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
    [Inject]
    private TareaState tareaState { get; set; } = default!;

    public IReadOnlyList<TareaModel> TareasFiltradas
    {
        get
        {
            IEnumerable<TareaModel> tareas = tareaState.Tareas;

            if (!string.IsNullOrEmpty(_prioridadSeleccionada))
            {
                if (Enum.TryParse<Prioridad>(_prioridadSeleccionada, out var prioridadEnum))
                    tareas = tareas.Where(t => t.Prioridad == prioridadEnum);
            }

            if (!string.IsNullOrEmpty(_completadaSeleccionada))
                tareas = _completadaSeleccionada == "Completadas"
                    ? tareas.Where(t => t.Completada)
                    : tareas.Where(t => !t.Completada);

            if (!string.IsNullOrEmpty(_vencimientoSeleccionado))
            {
                var today = DateOnly.FromDateTime(DateTime.Now);
                tareas = _vencimientoSeleccionado switch
                {
                    "Vencidas" => tareas.Where(t => t.FechaVencimiento < today),
                    "VencenHoy" => tareas.Where(t => t.FechaVencimiento == today),
                    "ATiempo" => tareas.Where(t => t.FechaVencimiento > today),
                    _ => tareas
                };
            }

            return tareas.ToList().AsReadOnly();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        tareaState.OnChange += StateHasChanged;
        await tareaState.Inicializar();
    }

    private async Task OnPrioridadChanged(string valor)
    {
        await Task.Run(() => _prioridadSeleccionada = valor);
    }

    private async Task OnEstadoChanged(string valor)
    {
        await Task.Run(() => _completadaSeleccionada = valor);
    }
    private async Task OnVencimientoChanged(string valor)
    {
        await Task.Run(() => _vencimientoSeleccionado = valor);
    }

    private void VerTarea(TareaModel tarea)
    {

        string url = $"/listaDeTareas/tarea/{tarea.IdPublic}";
        NavigationManager.NavigateTo(url);
    }

    private async Task CompletarTarea(TareaModel tarea)
    {
        await tareaState.Toggle(tarea.IdPublic);
    }

    private bool _showDeleteModal = false;
    private TareaModel? _tareaAEliminar;

    private void EliminarTarea(TareaModel tarea)
    {
        _tareaAEliminar = tarea;
        _showDeleteModal = true;
    }

    private async Task ConfirmarEliminar()
    {
        if (_tareaAEliminar is not null)
        {
            await tareaState.EliminarTarea(_tareaAEliminar.IdPublic);
            _tareaAEliminar = null;
        }
        _showDeleteModal = false;
    }

    private void CancelarEliminar()
    {
        _tareaAEliminar = null;
        _showDeleteModal = false;
    }

    private void IniciarEdicion(string id)
    {
        NavigationManager.NavigateTo($"/listaDeTareas/editarTarea/{id}");
    }

    private void NuevaTarea()
    {
        NavigationManager.NavigateTo("/listaDeTareas/nuevaTarea");
    }


    public void Dispose()
    {
        tareaState.OnChange -= StateHasChanged;
    }

}
