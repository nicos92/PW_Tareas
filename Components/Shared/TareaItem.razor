@using TareasBlazor.Helpers
@using TareasBlazor.Models
@using System.Threading.Tasks

<article class="list-group-item d-flex flex-column gap-2 @(Tarea.Completada ? "list-group-item-secondary" : "")">
    <div class="d-flex align-items-center gap-2 flex-wrap w-100">
        <input type="checkbox"
               class="form-check-input flex-shrink-0"
               checked="@Tarea.Completada"
               @onchange="Completar"
               aria-label="Marcar tarea '@Tarea.Titulo' como @(Tarea.Completada ? "pendiente" : "completada")" />
        <span class="@(Tarea.Completada ? "text-decoration-line-through text-muted flex-grow-1" : "flex-grow-1")">
            @Tarea.Titulo
            <span class="badge @PrioridadHelper.GetClase(Tarea.Prioridad) ms-1">@Tarea.Prioridad</span>
        </span>
        @if (ChildContent is not null)
        {
            <div class="d-flex align-items-center flex-shrink-0">
                @ChildContent
            </div>
        }
        <div class="d-flex gap-1 ms-auto flex-shrink-0">
            <button type="button"
                    class="btn btn-success"
                    @onclick="Ver"
                    aria-label="Ver detalle de '@Tarea.Titulo'">
                <i class="bi bi-eye" aria-hidden="true"></i>
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-primary"
                    @onclick="Editar"
                    aria-label="Editar tarea '@Tarea.Titulo'">
                <i class="bi bi-pencil" aria-hidden="true"></i>
            </button>
            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    @onclick="Eliminar"
                    aria-label="Eliminar tarea '@Tarea.Titulo'">
                <i class="bi bi-trash" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public TareaModel Tarea { get; set; } = default!;

    /// <summary>Contenido opcional definido por el padre (por ejemplo badges o metadatos).</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [Parameter]
    public EventCallback<TareaModel> OnVer { get; set; }

    [Parameter]
    public EventCallback<TareaModel> OnCompletar { get; set; }

    [Parameter]
    public EventCallback<TareaModel> OnEliminar { get; set; }

    [Parameter]
    public EventCallback<string> OnEditar { get; set; }

    private async Task Completar()
    {
        await OnCompletar.InvokeAsync(Tarea);
    }

    private async Task Eliminar()
    {
        await OnEliminar.InvokeAsync(Tarea);
    }

    private async Task Editar()
    {
        await OnEditar.InvokeAsync(Tarea.IdPublic);
    }

    private async Task Ver()
    {
        await OnVer.InvokeAsync(Tarea);
    }
}
