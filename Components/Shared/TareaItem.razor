@using TareasBlazor.Helpers
@using TareasBlazor.Models

<tr class="@(Tarea.Completada ? "table-secondary" : "")">
	<td class="text-nowrap" style="width:1%">
		<input id="@Tarea.IdPublic"
			   type="checkbox"
			   class="form-check-input"
			   checked="@Tarea.Completada"
			   @onchange="Completar"
			   aria-label="Marcar tarea '@Tarea.Titulo' como @(Tarea.Completada ? "pendiente" : "completada")" />
		<label class="form-check-label" for="@Tarea.IdPublic">
			@(Tarea.Completada ? "Completada" : "Pendiente")
		</label>
	</td>
	<td style="word-break:break-word">
		<span class="@(Tarea.Completada ? "text-decoration-line-through text-muted" : "")">
			@Tarea.Titulo
		</span>
	</td>
	<td style="word-break:break-word">
		<span class="badge @PrioridadHelper.GetClase(Tarea.Prioridad) ms-1">@Tarea.Prioridad</span>
	</td>
	<td class="text-nowrap" style="width:1%">
		<div class="d-flex gap-1">
			<button type="button"
					class="btn btn-success btn-sm"
					@onclick="Ver"
					aria-label="Ver detalle de '@Tarea.Titulo'">
				<i class="bi bi-eye" aria-hidden="true"></i>
			</button>
			<button type="button"
					class="btn btn-outline-primary btn-sm"
					@onclick="Editar"
					aria-label="Editar tarea '@Tarea.Titulo'">
				<i class="bi bi-pencil" aria-hidden="true"></i>
			</button>
			<button type="button"
					class="btn btn-outline-danger btn-sm"
					@onclick="Eliminar"
					aria-label="Eliminar tarea '@Tarea.Titulo'">
				<i class="bi bi-trash" aria-hidden="true"></i>
			</button>
		</div>
	</td>
</tr>

@code {
	[Parameter, EditorRequired]
	public TareaModel Tarea { get; set; } = default!;

	[Parameter]
	public EventCallback<TareaModel> OnVer { get; set; }

	[Parameter]
	public EventCallback<TareaModel> OnCompletar { get; set; }

	[Parameter]
	public EventCallback<TareaModel> OnEliminar { get; set; }

	[Parameter]
	public EventCallback<string> OnEditar { get; set; }

	private async Task Completar()
	{
		await OnCompletar.InvokeAsync(Tarea);
	}

	private async Task Eliminar()
	{
		await OnEliminar.InvokeAsync(Tarea);
	}

	private async Task Editar()
	{
		await OnEditar.InvokeAsync(Tarea.IdPublic);
	}

	private async Task Ver()
	{
		await OnVer.InvokeAsync(Tarea);
	}
}
