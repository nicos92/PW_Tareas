@page "/listaDeTareas/tarea/{id}"
@using TareasBlazor.Infraestructure.Interfaces
@using TareasBlazor.Infraestructure.Repositories
@using TareasBlazor.Models
@rendermode InteractiveServer
<PageTitle>Tarea</PageTitle>
<Breadcrum></Breadcrum>
<h3>Ver Tarea</h3>
<section class="container px-4 py-5" id="featured-3">
	<div class="row g-4 py-5 row-cols-1 row-cols-lg-3">
		<div class="feature col">
			@if (isLoading)
			{
				<h3 class="fs-2 text-body-emphasis" aria-live="polite">Cargando...</h3>
			}
			else
			{
				@DetalleTarea()
			}
			<a href="/listaDeTareas" class="icon-link" aria-label="Volver a la lista de tareas">
				Volver
				<svg class="bi" aria-hidden="true">
					<use xlink:href="#chevron-right"></use>
				</svg>
			</a>
		</div>
	</div>
</section>

@code {
	[Parameter]
	public string id { get; set; } = string.Empty;
	[Inject]
	private TareaState tareaState { get; set; } = default!;
	private bool isLoading = true;
	private TareaModel? tarea { get; set; }

	private RenderFragment DetalleTarea() => tarea != null
		? TareaEncontrada()
		: TareaNoEncontrada();

	private RenderFragment TareaEncontrada() => __builder =>
	{
		if (tarea != null)
		{
			<TareaCard Tarea="tarea" />
		}
	};

	private RenderFragment TareaNoEncontrada() => __builder =>
	{
		<h3 class="fs-2 text-body-emphasis text-danger">Tarea no encontrada</h3>
	};

	protected override async Task OnParametersSetAsync()
	{
		tarea = await tareaState.GetTareaById(id);
		isLoading = false;
		StateHasChanged();
	}
}
