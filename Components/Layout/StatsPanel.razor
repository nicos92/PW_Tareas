@inject TareaState tareaState
@implements IDisposable

<aside class="stats-panel" aria-label="Panel de estadísticas">
    <h3>Estadísticas</h3>
    <ul>
        <li>Total: @tareaState.Tareas.Count</li>
        <li>Completadas: @tareaState.Tareas.Count(t => t.Completada)</li>
        <li>Pendientes: @tareaState.Tareas.Count(t => !t.Completada)</li>
    </ul>
</aside>

@code {
    private static int _instanceCount = 0;
    private int _instanceId = ++_instanceCount;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"[StatsPanel #{_instanceId}] OnInitializedAsync - suscribiendo a OnChange");
        tareaState.OnChange += () =>
        {
            Console.WriteLine($"[StatsPanel #{_instanceId}] OnChange recibido - invocando StateHasChanged");
            _ = InvokeAsync(StateHasChanged);
        };
        await tareaState.Inicializar();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        Console.WriteLine($"[StatsPanel #{_instanceId}] OnAfterRender firstRender={firstRender} | Total={tareaState.Tareas.Count} Compl={tareaState.Tareas.Count(t=>t.Completada)} Pend={tareaState.Tareas.Count(t=>!t.Completada)}");
    }

    public void Dispose()
    {
        Console.WriteLine($"[StatsPanel #{_instanceId}] Dispose");
    }
}
