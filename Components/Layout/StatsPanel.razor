@inject TareaState tareaState
@implements IDisposable
@rendermode InteractiveServer

<aside class="stats-panel d-none d-lg-block" aria-label="Panel de estadísticas">
    <h3>Estadísticas</h3>
    <ul>
        <li>Total: @tareaState.Tareas.Count</li>
        <li>Completadas: @tareaState.Tareas.Count(t => t.Completada)</li>
        <li>Pendientes: @tareaState.Tareas.Count(t => !t.Completada)</li>
    </ul>
</aside>

@code {
    private static int _instanceCount = 0;
    private int _instanceId = ++_instanceCount;

    protected override async Task OnInitializedAsync()
    {
        tareaState.OnChange += StateHasChanged;
        await tareaState.Inicializar();
    }

    public void Dispose()
    {
        tareaState.OnChange -= StateHasChanged;
    }
}
