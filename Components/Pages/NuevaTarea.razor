@page "/listaDeTareas/nuevaTarea"
@using System.IO
@rendermode InteractiveServer

<PageTitle>Nueva Tarea</PageTitle>
<Breadcrum></Breadcrum>
<h3>Nueva Tarea</h3>

<TareaForm Model="tareaModel" OnValidSubmit="ValidSubmit" @ref="tareaForm">
    <ImageUploader OnImagenChanged="OnImagenChanged" MaxFileSize="1048576" @ref="imageUploader" />

    <button type="submit" class="btn btn-primary" disabled="@(tareaForm?.HasValidationErrors == true || imageUploader?.TamanoExcedido == true)">Guardar</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancelar">Cancelar</button>
</TareaForm>

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
    [Inject]
    private IWebHostEnvironment Environment { get; set; } = default!;
    [Inject]
	private TareaState tareaState { get; set; } = default!;
    private TareaModel tareaModel = new();
    private TareaForm? tareaForm;
    private ImageUploader? imageUploader;

    private async Task OnImagenChanged(ImageUploader.ImagenChangedEventArgs args)
    {
    }
    
    private async Task ValidSubmit()
    {
        if (imageUploader?.TamanoExcedido == true)
        {
            return;
        }
        
        tareaModel.IdPublic = Guid.NewGuid().ToString();
        
        if (imageUploader?.Archivo is not null)
        {
            tareaModel.Imagen = await GuardarArchivoAsync(imageUploader.Archivo);
        }
        
        await tareaState.AgregarTarea(tareaModel);
        NavigationManager.NavigateTo("/listaDeTareas");
    }
    
    private async Task<string> GuardarArchivoAsync(IBrowserFile archivo)
    {
        var trustedFileName = Path.GetRandomFileName();
        var extension = Path.GetExtension(archivo.Name);
        var fileName = trustedFileName + extension;
        
        var uploadsFolder = Path.Combine(Environment.WebRootPath, "uploads");
        Directory.CreateDirectory(uploadsFolder);
        
        var filePath = Path.Combine(uploadsFolder, fileName);
        
        await using FileStream fs = new(filePath, FileMode.Create);
        await archivo.OpenReadStream(1024 * 1024).CopyToAsync(fs);
        
        return $"/uploads/{fileName}";
    }
    
    private void Cancelar()
    {
        NavigationManager.NavigateTo("/listaDeTareas");
    }
}
