@inherits TareaEstadoComponentBase

<aside class="stats-panel d-none d-lg-block" aria-label="Panel de estadísticas">
    <h3>Estadísticas</h3>
    <h4>Estado:</h4>
    <div class="d-flex flex-column gap-2 mb-3">
        <StatsCard Title="Total" Value="@TareaEstado.Estadisticas.Total" BackgroundClass="surface-tint-primary"
                   CssClass="stats-card-compact" />
        <StatsCard Title="Listas" Value="@TareaEstado.Estadisticas.Completadas"
                   BackgroundClass="surface-tint-secondary" CssClass="stats-card-compact" />
        <StatsCard Title="Pendientes" Value="@TareaEstado.Estadisticas.Pendientes"
                   BackgroundClass="surface-tint-tertiary" CssClass="stats-card-compact" />
    </div>
    <h4>Prioridad:</h4>
    <ul>
        <li>Baja: @TareaEstado.Estadisticas.Baja</li>
        <li>Media: @TareaEstado.Estadisticas.Media</li>
        <li>Alta: @TareaEstado.Estadisticas.Alta</li>

    </ul>
    <h4>Vencimiento:</h4>
    <ul>
        <li>Vencidas: @TareaEstado.Estadisticas.Vencidas</li>
        <li>Vencen hoy: @TareaEstado.Estadisticas.VencenHoy</li>
        <li>A tiempo: @TareaEstado.Estadisticas.ATiempo</li>
    </ul>
</aside>
