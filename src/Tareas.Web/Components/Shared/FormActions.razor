<div class="mt-2">
    <button type="submit" class="btn @SubmitCssClass" disabled="@IsSubmitDisabled">@SubmitText</button>
    <button type="button" class="btn @CancelCssClass ms-2" @onclick="OnCancel">@CancelText</button>
</div>

@code {
    [Parameter] public bool IsSubmitDisabled { get; set; }
    [Parameter] public string SubmitText { get; set; } = "Guardar";
    [Parameter] public string CancelText { get; set; } = "Cancelar";
    [Parameter] public string SubmitCssClass { get; set; } = "btn-primary";
    [Parameter] public string CancelCssClass { get; set; } = "btn-secondary";
    [Parameter] public EventCallback OnCancel { get; set; }
}
