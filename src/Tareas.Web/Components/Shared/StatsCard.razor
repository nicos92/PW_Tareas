<article class="card @BackgroundClass @CssClass" aria-label="Tarjeta de estadistica">
    <div class="card-body">
        <h5 class="card-title">@Title</h5>
        <p class="card-text @ValueCssClass">@Value</p>
    </div>
</article>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public int Value { get; set; }
    [Parameter] public string BackgroundClass { get; set; } = "bg-primary";
    [Parameter] public string ValueCssClass { get; set; } = "display-4";
    [Parameter] public string CssClass { get; set; } = string.Empty;
}
