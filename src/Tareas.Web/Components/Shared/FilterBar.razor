@using System.Linq
@using Tareas.Application.Filtros
@using Tareas.Domain.ValueObjects

<fieldset class="row mb-3" aria-label="@AriaLabel" disabled="@IsLoading">
    <legend>@Legend</legend>

    <SelectFilter Id="filter-prioridad" Label="Prioridad" Options="_opcionesPrioridad"
                  Value="@PrioridadSeleccionada" EmptyLabel="Todas" Disabled="@IsLoading"
                  OnChanged="OnPrioridadChanged" />

    <SelectFilter Id="filter-estado" Label="Estado" Options="_opcionesEstado"
                  Value="@EstadoSeleccionado" EmptyLabel="Todas" Disabled="@IsLoading"
                  OnChanged="OnEstadoChanged" />

    <SelectFilter Id="filter-vencimiento" Label="Vencimiento" Options="_opcionesVencimiento"
                  Value="@VencimientoSeleccionado" EmptyLabel="Todas" Disabled="@IsLoading"
                  OnChanged="OnVencimientoChanged" />

    <div class="col d-flex align-items-end">
        <span class="text-muted" aria-live="polite" aria-atomic="true">
            Mostrando: @TotalTareas tarea@(TotalTareas != 1 ? "s" : "")
        </span>
    </div>
</fieldset>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Filtros de tareas";
    [Parameter] public string Legend { get; set; } = "Filtros de tareas";
    [Parameter] public string PrioridadSeleccionada { get; set; } = string.Empty;
    [Parameter] public string EstadoSeleccionado { get; set; } = string.Empty;
    [Parameter] public string VencimientoSeleccionado { get; set; } = string.Empty;
    [Parameter] public int TotalTareas { get; set; }
    [Parameter] public EventCallback<string> OnPrioridadChanged { get; set; }
    [Parameter] public EventCallback<string> OnEstadoChanged { get; set; }
    [Parameter] public EventCallback<string> OnVencimientoChanged { get; set; }

    private static readonly IReadOnlyList<SelectFilter.OpcionFiltro> _opcionesPrioridad =
        CrearOpciones<Prioridad>();

    private static readonly IReadOnlyList<SelectFilter.OpcionFiltro> _opcionesEstado =
        CrearOpciones<EstadoFiltro>(excluirPrimero: true);

    private static readonly IReadOnlyList<SelectFilter.OpcionFiltro> _opcionesVencimiento =
        CrearOpciones<VencimientoFiltro>(excluirPrimero: true);

    private static IReadOnlyList<SelectFilter.OpcionFiltro> CrearOpciones<TEnum>(bool excluirPrimero = false)
        where TEnum : struct, Enum
    {
        var valores = Enum.GetValues<TEnum>();
        if (excluirPrimero && valores.Length > 0)
        {
            valores = valores[1..];
        }

        return valores
            .Select(v => new SelectFilter.OpcionFiltro(v.ToString(), v.ToString()))
            .ToList();
    }
}
