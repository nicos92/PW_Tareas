<EditForm Model="Model" OnValidSubmit="OnValidSubmit" class="container" @ref="_editForm"
		  aria-label="Formulario de tarea">
	<DataAnnotationsValidator />
	<ValidationSummary aria-live="polite" />

	<div class="mb-3">

		
		<label for="idtitulo" class="form-label">Título:</label>
		<input id="idtitulo" value="@Model.Titulo" @oninput="OnTituloInput" class="form-control" maxlength="50" />
		<CharCounter Value="@Model.Titulo" MaxLength="50" />
		<ValidationMessage For="() => Model.Titulo" />

	</div>

	<div class="mb-3">
		<label for="iddescripcion" class="form-label">Descripción:</label>
		<textarea id="iddescripcion" value="@Model.Descripcion" @oninput="OnDescripcionInput" class="form-control"
				  rows="3" maxlength="200"></textarea>
		<CharCounter Value="@Model.Descripcion" MaxLength="200" />
		<ValidationMessage For="() => Model.Descripcion" />
	</div>

	<div class="mb-3">
		<label for="idcompletada" class="form-check-label">Lista:</label>
		<InputCheckbox id="idcompletada" @bind-Value="Model.Completada" class="form-check-input" />
	</div>

	<div class="mb-3">
		<label for="idfechavencimiento" class="form-label">Fecha de Vencimiento:</label>
		<input type="date" id="idfechavencimiento" @bind="Model.FechaVencimiento" @bind:after="OnFechaChanged"
			   class="form-control" lang="es-AR" />
	</div>

	<div class="mb-3">
		<label for="idprioridad" class="form-label">Prioridad:</label>
		<InputSelect id="idprioridad" @bind-Value="Model.Prioridad" class="form-select">
			@foreach (var prioridad in Enum.GetValues<Prioridad>())
			{
				<option value="@prioridad">@prioridad</option>
			}
		</InputSelect>
	</div>
	<div class="mb-3">
		<label for="idCategoria" class="form-label">Categoria:</label>
		<InputSelect id="idCategoria" @bind-Value="Model.Categoria" class="form-select">
			@foreach (var categoria in Enum.GetValues<Categoria>())
			{
				<option value="@categoria">@categoria</option>
			}
		</InputSelect>
	</div>

	@ChildContent
</EditForm>

@code {
	[Parameter, EditorRequired] public TareaDto Model { get; set; } = default!;
	[Parameter, EditorRequired] public EventCallback OnValidSubmit { get; set; }
	[Parameter] public RenderFragment? ChildContent { get; set; }

	private EditForm? _editForm;

	private readonly Dictionary<string, object> FechaAttrs = new()
	{
		{ "lang", "es-AR" }
	};

	private void OnTituloInput(ChangeEventArgs e)
	{
		Model.Titulo = e.Value?.ToString() ?? string.Empty;
		_editForm?.EditContext?.NotifyFieldChanged(FieldIdentifier.Create(() => Model.Titulo));
	}

	private void OnDescripcionInput(ChangeEventArgs e)
	{
		Model.Descripcion = e.Value?.ToString() ?? string.Empty;
		_editForm?.EditContext?.NotifyFieldChanged(FieldIdentifier.Create(() => Model.Descripcion));
	}

	private void OnFechaChanged()
	{
		_editForm?.EditContext?.NotifyFieldChanged(FieldIdentifier.Create(() => Model.FechaVencimiento));
	}

	public bool HasValidationErrors => _editForm?.EditContext?.GetValidationMessages().Any() ?? true;
}
