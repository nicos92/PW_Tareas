@page "/listaDeTareas/editarTarea/{Id}"
@inherits TareaFormPageBase

<PageTitle>Editar Tarea</PageTitle>
<Breadcrum SegmentNameResolver="ResolverTituloTarea" />
<h3>Editar Tarea</h3>

@if (tareaModel is null)
{
    <LoadingSpinner Mensaje="Cargando tarea..." />
}
else
{
    <CardSection Title="Editar tarea" HeaderId="editar-heading" AriaLabel="Formulario de edición de tarea">
        <TareaForm Model="tareaModel" OnValidSubmit="ValidSubmit" @ref="tareaForm">
            <ImageUploader CurrentImagen="@tareaModel.Imagen" OnImagenChanged="OnImagenChanged" MaxFileSize="MaxFileSize"
                           @ref="imageUploader" />

            <FormActions IsSubmitDisabled="@(tareaForm?.HasValidationErrors == true || ImagenInvalida)"
                         OnCancel="Cancelar" />
        </TareaForm>
    </CardSection>
}
