@page "/listaDeTareas/nuevaTarea"

<PageTitle>Nueva Tarea</PageTitle>
<Breadcrum></Breadcrum>
<h3>Nueva Tarea</h3>
<section class="card shadow-sm col-12" aria-label="Formulario de nueva tarea">
    <div class="card-header">
        <h5 class="mb-0" id="nueva-tarea-heading">Nueva tarea</h5>
    </div>
    <div class="card-body" aria-live="polite">
        <TareaForm Model="tareaModel" OnValidSubmit="ValidSubmit" @ref="tareaForm">
            <ImageUploader MaxFileSize="MaxFileSize" @ref="imageUploader" />

            <button type="submit" class="btn fill-primary"
                    disabled="@(tareaForm?.HasValidationErrors == true || imageUploader?.TamanoExcedido == true)">Guardar</button>
            <button type="button" class="btn fill-tertiary ms-2" @onclick="Cancelar">Cancelar</button>
        </TareaForm>
    </div>
</section>
