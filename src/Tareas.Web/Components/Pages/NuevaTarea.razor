@page "/listaDeTareas/nuevaTarea"
@inherits TareaFormPageBase

<PageTitle>Nueva Tarea</PageTitle>
<Breadcrum />
<h3>Nueva Tarea</h3>
<CardSection Title="Nueva tarea" HeaderId="nueva-tarea-heading" AriaLabel="Formulario de nueva tarea">
    <TareaForm Model="tareaModel" OnValidSubmit="ValidSubmit" @ref="tareaForm">
        <ImageUploader MaxFileSize="MaxFileSize" @ref="imageUploader" />

        <FormActions IsSubmitDisabled="@(tareaForm?.HasValidationErrors == true || ImagenInvalida)"
                     SubmitCssClass="fill-primary" CancelCssClass="fill-tertiary"
                     OnCancel="Cancelar" />
    </TareaForm>
</CardSection>
