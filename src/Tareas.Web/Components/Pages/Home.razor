@page "/"
@inherits TareaEstadoComponentBase

<PageTitle>Home</PageTitle>
<Breadcrum />

<h1>Gestión de Tareas!</h1>

<p class="lead">Bienvenido a la app para organizar tus tareas.</p>

<CardSection Title="Estadisticas" CssClass="col" AriaLabel="Tarjetas con estadisticas de tareas">
    <ul class="row mb-4 list-unstyled">
        <li class="col-md-4 p-1">
            <StatsCard Title="Total" Value="@TareaEstado.Estadisticas.Total" BackgroundClass="surface-tint-primary" />
        </li>
        <li class="col-md-4 p-1">
            <StatsCard Title="Listas" Value="@TareaEstado.Estadisticas.Completadas"
                       BackgroundClass="surface-tint-secondary" />
        </li>
        <li class="col-md-4 p-1">
            <StatsCard Title="Pendientes" Value="@TareaEstado.Estadisticas.Pendientes"
                       BackgroundClass="surface-tint-tertiary" />
        </li>
    </ul>
</CardSection>
